{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": { "SingleLine": true, "IncludeScopes": false }
    }
  },

  "Agent": {
    "CandidateProfilePath": "data/candidate-profile.json",
    "SeenJobsPath": "data/seen-jobs.json",
    "OutputDirectory": "output",
    "DryRun": false,
    "MaxParallelRequests": 3,
    "MaxAdsToMatchPerRun": 60,
    "MinScoreToHighlight": 60,
    "ExcludeHeadlineKeywords": [ "senior", "lead", "arkitekt", "architect", "principal", "chef", "head of", "erfaren", "experienced" ]
  },

  "JobTech": {
    "BaseUrl": "https://jobsearch.api.jobtechdev.se/",
    "PublishedWithinDays": 14,
    "MaxAdsPerQuery": 100,
    "Municipalities": [
      { "Name": "Göteborg", "ConceptId": "PVZL_BQT_XtL" },
      { "Name": "Mölndal", "ConceptId": "mc45_ki9_Bv3" },
      { "Name": "Partille", "ConceptId": "CCiR_sXa_BVW" },
      { "Name": "Kungälv", "ConceptId": "ZkZf_HbK_Mcr" }
    ],
    "Queries": [
      "C# utvecklare",
      ".NET utvecklare",
      "backendutvecklare",
      "fullstackutvecklare",
      "junior systemutvecklare",
      "applikationssupport",
      "applikationsspecialist",
      "applikationsförvaltare",
      "systemförvaltare",
      "systemtestare",
      "integrationsspecialist",
      "implementationsspecialist",
      "IT-tekniker",
      "systemadministratör"
    ]
  },

  "Claude": {
    "BaseUrl": "https://api.anthropic.com/",
    "Model": "claude-sonnet-5-5",
    "MaxTokens": 1500,
    "MaxAdChars": 12000
  },

  "Applications": {
    "Enabled": true,
    "MinScore": 65,
    "MaxLettersPerRun": 15,
    "CvPath": "data/Khalid_Hassan_CV.pdf",
    "SenderName": "Khalid Hassan",
    "SenderEmail": "khalidhassan968@gmail.com",
    "SenderPhone": "+46 79 357 82 65",
    "PortfolioUrl": "https://khalidhassanportfolio.netlify.app",
    "ImapHost": "imap.gmail.com"
  }
}
